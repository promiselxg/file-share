generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = "mongodb+srv://file-share:M3UcstTmmwwZJOD7@file-share.jxmqg.mongodb.net/file-share"
}

model User {
  id                      String          @id @default(cuid()) @map("_id")
  name                    String?
  email                   String?         @unique
  emailVerified           DateTime?
  imageUrl                String?
  admin                   Boolean         @default(false)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  documents               Document[]      @relation("UserToDocument")
  folders                 Folder[]        @relation("UserToFolder")
}

model Document {
  id        String    @id @default(cuid()) @map("_id")
  title     String    @unique
  folderId  String?
  view      Int       @default(0)
  userId    String
  user      User      @relation("UserToDocument", fields: [userId], references: [id], onDelete: Cascade)
  position  Int?
  starred   Boolean   @default(false)
  mediaInfo Json?
  createdBy Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Folder {
  id              String           @id @default(cuid()) @map("_id")
  name            String
  userId          String
  user            User             @relation("UserToFolder", fields: [userId], references: [id], onDelete: Cascade)
  subfolders      Subfolder[]      @relation("ParentToSubfolder")
  rootSubfolders  Subfolder[]     @relation("RootFolderToSubfolder")
}

model Subfolder {
  id             String       @id @default(cuid()) @map("_id")
  parentFolderId String
  parent         Folder       @relation("ParentToSubfolder", fields: [parentFolderId], references: [id])
  rootFolderId   String  
  rootFolder     Folder       @relation("RootFolderToSubfolder", fields: [rootFolderId], references: [id])
}
