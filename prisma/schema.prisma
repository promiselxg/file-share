generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid()) @map("_id")
  name        String?
  email       String?      @unique
  emailVerified DateTime?
  imageUrl    String?
  admin       Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  documents   Document[]   @relation("UserToDocument")
  folders     Folder[]     @relation("UserToFolder")
}

model Document {
  id          String    @id @default(cuid()) @map("_id")
  title       String    
  folderId    String?
  folder      Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  view        Int       @default(0)
  userId      String
  imgUrl      String[]
  imageId     String[]
  user        User      @relation("UserToDocument", fields: [userId], references: [id], onDelete: Cascade)
  position    Int?
  shareLink   String?
  mediaInfo   Json?
  createdBy   Json?
  trashed     Boolean?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Folder {
  id          String       @id @default(cuid()) @map("_id")
  name        String
  userId      String
  favorite    Boolean      @default(false)
  position    Int?
  shareLink   String?
  trashed     Boolean?
  user        User         @relation("UserToFolder", fields: [userId], references: [id], onDelete: Cascade)
  parentId    String?       
  parent      Folder?      @relation("ParentToFolder", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Folder[]     @relation("ParentToFolder")
  documents   Document[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
